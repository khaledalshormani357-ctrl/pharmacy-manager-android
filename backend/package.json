    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.5",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/jsonwebtoken": "^9.0.2",
    "prisma": "^5.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.2",
    "ts-node": "^10.9.1"
  }
